# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Where the model lives and where the index lives are INDEPENDENT, and conflating
# them is the most confusing thing about running this project:
#
#   MODEL_BACKEND  where chat completions and embeddings come from
#   PGHOST         which Postgres — and so which corpus — is searched
#
# There is no offline mode. Retrieval embeds your query, so every path needs a
# real endpoint. A missing key is an error naming the variable, not a silent
# downgrade — run `travel-assist doctor` and it will tell you which one.
#
# What you may NOT do is query an index some other model built. The vectors live
# in different spaces, so retrieval keeps returning confident-looking passages
# that are simply wrong, and nothing errors. The frozen-embedding guard refuses
# it at startup instead.

# ---- Model ----------------------------------------------------------------
MODEL_BACKEND=azure              # azure — the only value
# The resource base URL. Paste the Foundry portal's value even if it ends in
# `/openai/v1` — config strips the API path, because the Azure classes append
# their own `/openai/deployments/<name>/...` and the doubled path 404s.
AZURE_OPENAI_ENDPOINT=https://af-rootsacademy-26-genai.cognitiveservices.azure.com
AZURE_OPENAI_API_KEY=
# Take this from the deployment's target URI in the Foundry portal rather than
# from here — an api-version older than the model usually fails as a 404 on the
# deployment, which reads like a wrong deployment name.
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_CHAT_DEPLOYMENT=gpt-5.4-mini   # the DEPLOYMENT name you chose, not the model id
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small   # FROZEN — must match index_metadata
# FROZEN — must match index_metadata, and capped at 2000 by pgvector's HNSW index.
# text-embedding-3-large is natively 3072, truncated here via the `dimensions` parameter.
EMBEDDING_DIM=1536

# ---- Index ----------------------------------------------------------------
# There is no local database and no Docker. This is the shared, pre-populated
# Azure Postgres — fill it in from the credentials handed out at the start of
# the day. It is read-only; nobody can break it for anybody else.
PGHOST=rootsacademy-travel-assist.postgres.database.azure.com
PGPORT=5432
PGDATABASE=travel_assist
# Your own row from the credential handout — one role per participant,
# read-only. Instructors seeding the index use the admin account instead.
PGUSER=
PGPASSWORD=
PGSSLMODE=require                # Azure Postgres refuses anything weaker

# ---- Observability -------------------------------------------------------
# MLflow, local. Nothing to provision: this is one SQLite file, and
# `make mlflow-ui` renders trace trees, span timings and token counts from it.
# Point it at a tracking server only if you have one — you do not need one.
# (Not `file:./mlruns`: MLflow 3.15 raises on the filesystem store by default.)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT=travel-assist

# ---- Context management ----------------------------------------------------
CONTEXT_TOKEN_BUDGET=8000
HISTORY_TOKEN_BUDGET=2000
COMPACTION_STRATEGY=summarise    # summarise | drop_oldest | none
